# Supabase Edge Function secrets. Set with:  supabase secrets set --env-file .env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.)

SITE_URL=https://your-site.vercel.app          # used in emails, Stripe redirects and one-click links

# Email (Gmail app password now; later switch SMTP_HOST/SMTP_PORT/MAIL_FROM to a domain provider)
GMAIL_USER=easybeanscafe@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
OWNER_EMAIL=easybeanscafe@gmail.com            # optional: where owner alerts go (defaults to GMAIL_USER)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="Solicita <hola@yourdomain.es>"

# Company lookup (Registro Mercantil) - apiempresas.es, 100 free lookups
APIEMPRESAS_KEY=

# Stripe (use sk_test_/whsec_ test values first)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
